{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IDE Release",
  "description": "One release of a GitHub Copilot IDE extension or integration.",
  "type": "object",
  "required": [
    "ide",
    "version",
    "release_date",
    "title",
    "url",
    "source",
    "body_markdown",
    "fetched_at",
    "schema_version"
  ],
  "additionalProperties": false,
  "properties": {
    "ide": {
      "type": "string",
      "description": "IDE identifier matching config/ides.yml id field."
    },
    "version": {
      "type": "string",
      "description": "Normalised version string (e.g. 1.75.0)."
    },
    "release_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO-8601 date (YYYY-MM-DD)."
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "description": "Canonical release-notes URL."
    },
    "source": {
      "type": "string",
      "enum": ["feed", "html", "api", "api_fallback"],
      "description": "How the data was obtained."
    },
    "body_markdown": {
      "type": "string",
      "description": "Full release notes as Markdown."
    },
    "body_html": {
      "type": ["string", "null"],
      "description": "Raw HTML body, if available."
    },
    "categories": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Tag/category labels from the source."
    },
    "copilot_mentions": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Snippets from body_markdown matching the Copilot/AI heuristic."
    },
    "builds": {
      "type": "array",
      "description": "JetBrains-specific: per-IDE-build compatibility info.",
      "items": {
        "type": "object",
        "properties": {
          "ide_build": {"type": ["string", "null"]},
          "since": {"type": ["string", "null"]},
          "until": {"type": ["string", "null"]},
          "compatible_versions": {},
          "file_id": {"type": ["integer", "null"]},
          "downloads": {"type": ["integer", "null"]}
        }
      }
    },
    "prerelease": {
      "type": "boolean",
      "description": "True for GitHub pre-release tags (Xcode, Vim/Neovim)."
    },
    "neovim_era": {
      "type": "string",
      "description": "Vim/Neovim-specific section key from the feature matrix page."
    },
    "xcode_era": {
      "type": "string",
      "description": "Xcode-specific era section key from the feature matrix page."
    },
    "fetched_at": {
      "type": "string",
      "description": "ISO-8601 datetime when the record was written."
    },
    "schema_version": {
      "type": "integer",
      "enum": [1],
      "description": "Schema version — increment when breaking changes are made."
    }
  }
}
