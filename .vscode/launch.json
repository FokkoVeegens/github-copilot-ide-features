{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Website",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/server.js",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "Server running at (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ]
}
